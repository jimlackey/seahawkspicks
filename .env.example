# ============================================================================
# Seahawks Score Picks — Environment Variables
# Copy to .env.local (for local dev) and configure the same in Vercel's
# Project Settings → Environment Variables for deployment.
# ============================================================================

# --- Supabase (server-side only — used by api/_lib/supabaseAdmin.js) ---
# The service_role key bypasses RLS, so it must NEVER be prefixed with
# VITE_ (that would bundle it into the client-side JS). All data access
# goes through the /api/* serverless functions now, not directly from the
# browser, so no anon key is needed at all.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Resend (email delivery for login codes) ---
RESEND_API_KEY=re_...
# Must be a verified sender in Resend. For local dev, Resend allows
# onboarding@resend.dev.
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Auth / Sessions ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=your-64-char-hex-secret-here
# Session duration in hours. Default 2160 = 90 days.
SESSION_DURATION_HOURS=2160

# --- Odds API (server-side only — used by api/sync-week.js) ---
ODDS_API_KEY=your-odds-api-key

# --- App ---
# Base URL used to build links in emails (access-request "Grant access"
# link). Set this to wherever the app is actually reachable —
# e.g. https://www.jimlackey.com/seahawks once deployed there.
APP_URL=http://localhost:5173
