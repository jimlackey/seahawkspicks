# ============================================================================
# Seahawks Score Picks — Environment Variables
# Copy to .env.local (for local dev) and configure the same in Vercel's
# Project Settings → Environment Variables for deployment.
# ============================================================================

# --- Supabase (server-side only — used by api/_lib/supabaseAdmin.js) ---
# Use the Secret Key (sb_secret_...) from Settings → API Keys — NOT the
# Publishable Key, and not the legacy anon key. The Secret Key is
# Supabase's current name for what used to be called the service_role
# key; it still bypasses RLS the same way, it's just no longer JWT-
# formatted. The env var name below is kept as SERVICE_ROLE_KEY for
# consistency with the rest of this codebase, but the value you paste in
# should be the Secret Key.
# The Project URL itself is on a different tab — Settings → Data API (or
# the "Connect" button on the project dashboard) — not the API Keys tab.
# Never prefix either of these with VITE_ (that would bundle them into
# client-side JS). All data access goes through the /api/* serverless
# functions now, not directly from the browser, so no publishable/anon
# key is needed at all.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Resend (email delivery for login codes) ---
RESEND_API_KEY=re_...
# Must be a verified sender in Resend. For local dev, Resend allows
# onboarding@resend.dev.
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Auth / Sessions ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=your-64-char-hex-secret-here
# Session duration in hours. Default 2160 = 90 days.
SESSION_DURATION_HOURS=2160

# --- Odds API (server-side only — used by api/sync-week.js) ---
ODDS_API_KEY=your-odds-api-key

# --- App ---
# Base URL used to build links in emails (access-request "Grant access"
# link). Set this to wherever the app is actually reachable —
# e.g. https://www.jimlackey.com/seahawks once deployed there.
APP_URL=http://localhost:5173
